# Local development settings (copy to .env). manage.py uses config.settings.local.
# Production values are set by researchit-deploy (stacks/web/app.env.j2).
DJANGO_SECRET_KEY=change-me-local-only
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional: Umami analytics (leave empty to disable)
UMAMI_SCRIPT_URL=
UMAMI_WEBSITE_ID=
